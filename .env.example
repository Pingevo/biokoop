# =====================================================
# biokoop — Environment Configuration
# =====================================================
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริงทั้งหมด
# ใน production: ตั้ง NODE_ENV=production เพื่อบังคับ secure cookie

# ─── LINE Messaging API ───
# จาก LINE Developers Console → Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ─── MongoDB ───
MONGODB_URI=mongodb://localhost:27017/biokoop
# (optional) MongoDB สำหรับอ่าน dbWallet — ถ้าไม่ใส่จะใช้ useDb fallback
MONGODB_WALLET_URI=

# ─── AI API Keys ───
GEMINI_API_KEY=
# OpenRouter (โมเดลที่ 2 สำหรับ cross-check, ไม่ใส่ก็ได้ถ้าใช้ตัวเดียว)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ─── Server ───
# Base URL ของเซิร์ฟเวอร์ (ต้องเป็น HTTPS จริง เพื่อให้ LINE ดึงรูปผลลัพธ์ได้
# และ system81 SSO redirect กลับมาได้)
PUBLIC_BASE_URL=https://your-domain.example.com

# Port ที่ Express ฟัง (Plesk/Passenger จะ set PORT ให้อัตโนมัติ ปกติไม่ต้องแก้)
PORT=5000

# โหมด production — บังคับ secure cookie สำหรับ session (ตั้งเป็น production เมื่อ deploy จริง)
NODE_ENV=development

# ─── AI Pipeline ───
# Confidence ขั้นต่ำที่ยอมให้ส่งอัตโนมัติ (0-1)
CONFIDENCE_THRESHOLD=0.7

# ─── LINE Admin Commands (ผ่าน chat, ไม่เกี่ยวกับ web admin panel) ───
# LINE User ID ของแอดมินสำหรับรับการแจ้งเตือน alert และใช้คำสั่ง /stats /review (ใส่หลายคนคั่นด้วย ,)
ADMIN_LINE_USER_IDS=
# รหัสผ่านสำหรับคำสั่ง LINE `/admin auth <password>` (web admin panel ใช้ SSO แล้ว ไม่เกี่ยวกับค่านี้)
ADMIN_PASSWORD=change-me-in-production

# =====================================================
# ระบบหลังบ้าน Admin (login ผ่าน system81 SSO ของ ITSR)
# =====================================================

# Secret สำหรับ sign session cookie — ต้องตั้งเป็นค่าสุ่มยาวๆ ใน production
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# หรือ:    openssl rand -hex 32
SESSION_SECRET=

# Base URL ของ sellcenter / ITSR system81 (ค่าเริ่มต้นใช้ของจริง)
SELLCENTER_OAUTH_BASE_URL=https://data.digital.in.th

# ชื่อแอปที่จะแสดงบนหน้า login ของ ITSR system81
ADMIN_APP_NAME=biokoop Admin

# Domain ของบัญชี ITSR ที่จะ auto-provision เป็น admin เมื่อ login ครั้งแรก
# กฎ: บัญชี @itsr.co.th คนแรกของระบบ → superadmin (Lv.2) อัตโนมัติ
#      คนถัดไปใน domain นี้ → admin (Lv.1) — superadmin เลื่อนขั้นให้ได้ในหน้าจัดการ admin
#      บัญชีนอก domain นี้ → ปฏิเสธ (ยังไม่มี flow เพิ่ม admin นอก domain เอง)
AUTO_PROVISION_DOMAIN=@itsr.co.th
