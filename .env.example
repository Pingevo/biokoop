# LINE Messaging API (จาก LINE Developers Console)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# MongoDB
MONGODB_URI=
MONGODB_WALLET_URI=

# Gemini API
GEMINI_API_KEY=

# OpenRouter (โมเดลที่ 2 สำหรับ cross-check, ไม่ใส่ก็ได้ถ้าใช้ตัวเดียว)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Base URL ของเซิร์ฟเวอร์ (ต้องเป็น HTTPS จริง เพื่อให้ LINE ดึงรูปผลลัพธ์ได้)
PUBLIC_BASE_URL=

# Port ที่ Express ฟัง (Plesk/Passenger จะ set PORT ให้อัตโนมัติ ปกติไม่ต้องแก้)
PORT=

# Confidence ขั้นต่ำที่ยอมให้ส่งอัตโนมัติ (0-1)
CONFIDENCE_THRESHOLD=

# Admin UI Security (รหัสผ่านสำหรับเข้าหน้าแอดมิน)
ADMIN_PASSWORD=

# LINE User ID ของแอดมินสำหรับรับการแจ้งเตือน alert และใช้คำสั่ง /stats /review (ใส่ได้หลายคน คั่นด้วยจุลภาค ,)
ADMIN_LINE_USER_IDS=

# AI Usage Hub (Centralized Token Logging)
AI_USAGE_HUB_URL=
AI_USAGE_HUB_TOKEN=
# ─── LLM Keys (หน้า /llmkey2) ───
LLMKEY_ENCRYPTION_KEY=
