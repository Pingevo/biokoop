# biokoop Python chatbot — FastAPI/uvicorn (port 5001, internal เท่านั้น)
FROM python:3.12-slim

WORKDIR /app

COPY chatbot/requirements.txt ./chatbot/requirements.txt
RUN pip install --no-cache-dir -r chatbot/requirements.txt

COPY chatbot ./chatbot

EXPOSE 5001

CMD ["uvicorn", "chatbot.app:app", "--host", "0.0.0.0", "--port", "5001"]
